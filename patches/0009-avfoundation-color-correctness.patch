+
+static CFStringRef primaries_tag(enum pl_color_primaries prim)
+{
+    switch (prim) {
+    case PL_COLOR_PRIM_BT_709: return kCVImageBufferColorPrimaries_ITU_R_709_2;
+    case PL_COLOR_PRIM_BT_2020: return kCVImageBufferColorPrimaries_ITU_R_2020;
+    case PL_COLOR_PRIM_BT_601_525: return kCVImageBufferColorPrimaries_SMPTE_C;
+    case PL_COLOR_PRIM_BT_601_625: return kCVImageBufferColorPrimaries_EBU_3213;
+    case PL_COLOR_PRIM_DISPLAY_P3: return kCVImageBufferColorPrimaries_P3_D65;
+    case PL_COLOR_PRIM_DCI_P3: return kCVImageBufferColorPrimaries_DCI_P3;
+    default: return NULL;
+    }
+}
+
+static CFStringRef transfer_tag(enum pl_color_transfer trc, float *gamma)
+{
+    *gamma = 0;
+    switch (trc) {
+    case PL_COLOR_TRC_BT_1886: return kCVImageBufferTransferFunction_ITU_R_709_2;
+    case PL_COLOR_TRC_SRGB: return kCVImageBufferTransferFunction_sRGB;
+    case PL_COLOR_TRC_PQ: return kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ;
+    case PL_COLOR_TRC_HLG: return kCVImageBufferTransferFunction_ITU_R_2100_HLG;
+    case PL_COLOR_TRC_LINEAR: return kCVImageBufferTransferFunction_Linear;
+    case PL_COLOR_TRC_ST428: return kCVImageBufferTransferFunction_SMPTE_ST_428_1;
+    case PL_COLOR_TRC_GAMMA22: *gamma = 2.2f; return kCVImageBufferTransferFunction_UseGamma;
+    case PL_COLOR_TRC_GAMMA28: *gamma = 2.8f; return kCVImageBufferTransferFunction_UseGamma;
+    default: return NULL;
+    }
+}
+
+static CGColorSpaceRef colorspace_for_transfer(enum pl_color_transfer trc)
+{
+    CFStringRef name = kCGColorSpaceITUR_709;
+    if (trc == PL_COLOR_TRC_PQ)
+        name = kCGColorSpaceITUR_2020_PQ;
+    else if (trc == PL_COLOR_TRC_HLG)
+        name = kCGColorSpaceITUR_2020_HLG;
+    else if (trc == PL_COLOR_TRC_SRGB)
+        name = kCGColorSpaceSRGB;
+    return CGColorSpaceCreateWithName(name);
+}
+
+static void rgb_tags_for_transfer(enum pl_color_transfer trc,
+                                  CFStringRef *prim, CFStringRef *transfer)
+{
+    float unused = 0;
+    enum pl_color_transfer tag = trc;
+    if (trc != PL_COLOR_TRC_PQ && trc != PL_COLOR_TRC_HLG && trc != PL_COLOR_TRC_SRGB)
+        tag = PL_COLOR_TRC_BT_1886;
+    *transfer = transfer_tag(tag, &unused);
+    *prim = transfer_is_pq_hlg(trc) ? kCVImageBufferColorPrimaries_ITU_R_2020
+                                    : kCVImageBufferColorPrimaries_ITU_R_709_2;
+}
+
+static CGColorSpaceRef buffer_color_space(CVPixelBufferRef buf)
+{
+    CGColorSpaceRef attached = (CGColorSpaceRef)CVBufferGetAttachment(
+        buf, kCVImageBufferCGColorSpaceKey, NULL);
+    if (attached)
+        return CGColorSpaceRetain(attached);
+
+    CFDictionaryRef attachments = CVBufferCopyAttachments(
+        buf, kCVAttachmentMode_ShouldPropagate);
+    if (!attachments)
+        return NULL;
+    CGColorSpaceRef created = CVImageBufferCreateColorSpaceFromAttachments(attachments);
+    CFRelease(attachments);
+    return created;
+}
+
+static enum pl_color_transfer buffer_pq_hlg(CVPixelBufferRef buf)
+{
+    CFStringRef trc = CVBufferGetAttachment(buf, kCVImageBufferTransferFunctionKey, NULL);
+    if (!trc)
+        return PL_COLOR_TRC_UNKNOWN;
+    if (CFEqual(trc, kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ))
+        return PL_COLOR_TRC_PQ;
+    if (CFEqual(trc, kCVImageBufferTransferFunction_ITU_R_2100_HLG))
+        return PL_COLOR_TRC_HLG;
+    return PL_COLOR_TRC_UNKNOWN;
+}
+
+static void note_hdr_output(struct priv *p, const struct mp_image *mpi,
+                            CVPixelBufferRef buf)
+{
+    if (transfer_is_pq_hlg(p->hdr_transfer))
+        return;
+    enum pl_color_transfer trc = pixel_transfer(&mpi->params);
+    if (!transfer_is_pq_hlg(trc))
+        trc = buffer_pq_hlg(buf);
+    if (transfer_is_pq_hlg(trc))
+        p->hdr_transfer = trc;
+}
+
+// ISO/IEC 23008-2 mastering display (D.2.28) and content light level (D.2.35),
+// big-endian. xy is 16-bit 0.16; luminance is in 0.0001 cd/m2 units.
+static uint16_t xy_be(float v)
+{
+    if (!(v > 0.f))
+        return 0;
+    if (v > 1.f)
+        v = 1.f;
+    return CFSwapInt16HostToBig((uint16_t)(v * 50000.f + 0.5f));
+}
+
+static uint32_t nits_be(float nits)
+{
+    if (!(nits > 0.f))
+        return 0;
+    double scaled = (double)nits * 10000.0;
+    if (scaled > 4294967295.0)
+        scaled = 4294967295.0;
+    return CFSwapInt32HostToBig((uint32_t)(scaled + 0.5));
+}
