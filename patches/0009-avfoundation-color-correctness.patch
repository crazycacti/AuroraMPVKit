+    memcpy(raw + 16, luma, sizeof(luma));
+    return CFDataCreate(NULL, (const UInt8 *)raw, sizeof(raw));
+}
+
+static CFDataRef content_light_data(const struct pl_hdr_metadata *hdr)
+{
+    if (!(hdr->max_cll > 0.f || hdr->max_fall > 0.f))
+        return NULL;
+    float cll = hdr->max_cll > 65535.f ? 65535.f : hdr->max_cll;
+    float fall = hdr->max_fall > 65535.f ? 65535.f : hdr->max_fall;
+    uint16_t v[2] = {
+        CFSwapInt16HostToBig((uint16_t)(cll > 0.f ? cll + 0.5f : 0)),
+        CFSwapInt16HostToBig((uint16_t)(fall > 0.f ? fall + 0.5f : 0)),
+    };
+    return CFDataCreate(NULL, (const UInt8 *)v, sizeof(v));
+}
+
+static void attach_hdr_side_data(CVPixelBufferRef dst, CVPixelBufferRef src,
+                                 const struct mp_image *mpi, bool hdr)
+{
+    CFTypeRef mdcv = src ? CVBufferGetAttachment(
+        src, kCVImageBufferMasteringDisplayColorVolumeKey, NULL) : NULL;
+    CFDataRef made_mdcv = NULL;
+    if (!mdcv && hdr && mpi) {
+        made_mdcv = mastering_data(&mpi->params.color.hdr);
+        mdcv = made_mdcv;
+    }
+    set_attachment(dst, kCVImageBufferMasteringDisplayColorVolumeKey, mdcv);
+    if (made_mdcv)
+        CFRelease(made_mdcv);
+
+    CFTypeRef cll = src ? CVBufferGetAttachment(
+        src, kCVImageBufferContentLightLevelInfoKey, NULL) : NULL;
+    CFDataRef made_cll = NULL;
+    if (!cll && hdr && mpi) {
+        made_cll = content_light_data(&mpi->params.color.hdr);
+        cll = made_cll;
+    }
+    set_attachment(dst, kCVImageBufferContentLightLevelInfoKey, cll);
+    if (made_cll)
+        CFRelease(made_cll);
+}
+
+static void tag_rgb_output(CVPixelBufferRef dst, CVPixelBufferRef src,
+                           const struct mp_image *mpi, enum pl_color_transfer dest,
+                           CGColorSpaceRef space)
+{
+    CFStringRef prim = NULL, transfer = NULL;
+    rgb_tags_for_transfer(dest, &prim, &transfer);
+    // Half-float output is RGB. A YCbCr matrix on it makes the display treat
+    // the samples as video-range YUV.
+    CVBufferRemoveAttachment(dst, kCVImageBufferYCbCrMatrixKey);
+    CVBufferRemoveAttachment(dst, kCVImageBufferGammaLevelKey);
+    set_attachment(dst, kCVImageBufferColorPrimariesKey, prim);
+    set_attachment(dst, kCVImageBufferTransferFunctionKey, transfer);
+    set_attachment(dst, kCVImageBufferCGColorSpaceKey, space);
+    attach_hdr_side_data(dst, src, mpi, transfer_is_pq_hlg(dest));
+}
+
+static void tag_software_buffer(CVPixelBufferRef buf, const struct mp_image *mpi)
+{
+    float gamma = 0;
+    const struct mp_image_params *par = &mpi->params;
+    set_attachment(buf, kCVImageBufferYCbCrMatrixKey, matrix_tag(pixel_system(par)));
+    set_attachment(buf, kCVImageBufferColorPrimariesKey, primaries_tag(pixel_primaries(par)));
+    set_attachment(buf, kCVImageBufferTransferFunctionKey,
+                   transfer_tag(pixel_transfer(par), &gamma));
+    if (gamma != 0) {
+        CFNumberRef level = CFNumberCreate(NULL, kCFNumberFloat32Type, &gamma);
+        set_attachment(buf, kCVImageBufferGammaLevelKey, level);
+        CFRelease(level);
+    } else {
+        set_attachment(buf, kCVImageBufferGammaLevelKey, NULL);
     }
+
+    // Drop a recycled color space so the new tags are what get rebuilt.
+    set_attachment(buf, kCVImageBufferCGColorSpaceKey, NULL);
+    CGColorSpaceRef space = buffer_color_space(buf);
+    set_attachment(buf, kCVImageBufferCGColorSpaceKey, space);
+    if (space)
+        CGColorSpaceRelease(space);
+    attach_hdr_side_data(buf, NULL, mpi, transfer_is_pq_hlg(pixel_transfer(par)));
 }
 
