+// Tell the display layer the shape of one pixel so anamorphic sources keep their display aspect.
+static void set_pixel_aspect(CVPixelBufferRef buf, const struct mp_image *mpi)
+{
+    int p_w = mpi->params.p_w;
+    int p_h = mpi->params.p_h;
+    if (!buf || p_w <= 0 || p_h <= 0 || p_w == p_h)
+        return;
+
+    CFNumberRef h = CFNumberCreate(NULL, kCFNumberIntType, &p_w);
+    CFNumberRef v = CFNumberCreate(NULL, kCFNumberIntType, &p_h);
+    const void *keys[] = {kCVImageBufferPixelAspectRatioHorizontalSpacingKey,
+                          kCVImageBufferPixelAspectRatioVerticalSpacingKey};
+    const void *values[] = {h, v};
+    CFDictionaryRef par = CFDictionaryCreate(NULL, keys, values, 2,
+                                             &kCFTypeDictionaryKeyCallBacks,
+                                             &kCFTypeDictionaryValueCallBacks);
+    CFRelease(h);
+    CFRelease(v);
+    if (par) {
+        CVBufferSetAttachment(buf, kCVImageBufferPixelAspectRatioKey, par,
+                              kCVAttachmentMode_ShouldPropagate);
+        CFRelease(par);
+    }
+}
